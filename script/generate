#!/usr/bin/env bash

set -euo pipefail

# ==============================================================================
# Bash definitions

if [[ -n ${BASH_SOURCE[0]} ]]; then
    script_path="${BASH_SOURCE[0]}"
else
    script_path="$0"
fi

script_dir="$(realpath "$(dirname "${script_path}")")"
repo_dir="$(dirname "${script_dir}")"
sdk_dir="${repo_dir}/sdks/simplicity_sdk"

# shellcheck source=script/slc_cli
source "${repo_dir}/script/slc_cli"

# shellcheck source=script/util
source "${repo_dir}/script/util"

# ==============================================================================
trust_sdk_and_extensions()
{
    # TODO: Figure out a way to skip the trust command if the SDK or extensions are already trusted

    # List of dirs containing SDK extensions to trust
    # NOTE: this list must only contain absolute paths since it will be used to generate symlinks
    extension_dirs=(
        "${repo_dir}"
        "${repo_dir}/sdks/wiseconnect"
    )

    # Add a vendor slc extension if the path to one is defined
    if [ -n "${VENDOR_EXTENSION-}" ]; then
        local vendor_extension_abs_path=""
        case "${VENDOR_EXTENSION}" in
            /*)
                # absolute path
                vendor_extension_abs_path="${VENDOR_EXTENSION}"
                ;;
            *)
                # relative path
                vendor_extension_abs_path=$(realpath "$(pwd)/${VENDOR_EXTENSION}")
                if [ ! -d "${vendor_extension_abs_path}" ]; then
                    set +x
                    echo "VENDOR_EXTENSION=${VENDOR_EXTENSION}"
                    echo "script_dir=${script_dir}"
                    echo "vendor_extension_abs_path=${vendor_extension_abs_path}"
                    echo "ERROR: '${vendor_extension_abs_path}' does not exist"
                    exit 5
                fi
                ;;
        esac

        extension_dirs+=("${vendor_extension_abs_path}")
    fi

    # Canonicalize SDK path so SLC path checks work when sdks/ is a symlink
    # (e.g. shared SDK tree outside this worktree).
    sdk_dir="$(realpath "${sdk_dir}")"

    set +x
    echo "======================================================================"
    echo "Trusting Simplicity SDK              :'${sdk_dir}':"
    echo "======================================================================"
    set -x

    # Trust the Simplicity SDK submodule
    run_slc -v INFO signature trust --sdk "${sdk_dir}" -data "${tuyaopen_slc_data}"

    # Ensure SDK extension folder exists
    mkdir -p "${sdk_dir}/extension"

    set +x
    echo ""
    echo ""
    echo "======================================================================"
    echo "extension_dirs = (${extension_dirs[*]})"
    echo "======================================================================"
    set -x

    # Symlink and trust the extensions
    for extension_dir in "${extension_dirs[@]}"; do

        # Locate .slce file
        local slce_file=()
        slce_file=($(find "${extension_dir}" -maxdepth 1 -name '*.slce'))
        if [ -z "${slce_file}" ]; then
            echo "ERROR: Couldn't find .slce file at '${extension_dir}'"
            continue
        fi

        # Parse extension name
        for file in "${slce_file[@]}"; do
            local extension_name=""
            extension_line=$(grep -m 1 'id: ' "${file}")
            extension_name="${extension_line//id:/}"
            extension_name="${extension_name// /}"
            # Guard against CRLF in upstream .slce files (e.g. "wiseconnect3_sdk\r")
            extension_name="${extension_name//$'\r'/}"

            # Define symlink location (must stay under canonical sdk_dir)
            local extension_symlink="${sdk_dir}/extension/${extension_name}"

            set +x
            echo ""
            echo ""
            echo "======================================================================"
            echo "Trusting extension '${extension_name}'"
            echo "======================================================================"
            set -x

            # Always refresh the link so a shared SDK points at the current
            # worktree. link_dir in script/util because Windows needs a junction.
            link_dir "${extension_dir}" "${extension_symlink}"

            # Trust the extension (extpath must be under the same real sdk_dir)
            run_slc -v INFO signature trust --sdk "${sdk_dir}" -extpath "${extension_symlink}" -data "${tuyaopen_slc_data}"
        done
    done

    ls -alh "${sdk_dir}/extension"
}

patch_linkerfile()
{
    local linker_file=""
    if [ -f "$1/autogen/linkerfile_common.ld" ]; then
        linker_file="$1/autogen/linkerfile_common.ld"
    elif [ -f "$1/autogen/linkerfile_SoC.ld" ]; then
        linker_file="$1/autogen/linkerfile_SoC.ld"
    elif [ -f "$1/autogen/linkerfile_psram_SoC.ld" ]; then
        linker_file="$1/autogen/linkerfile_psram_SoC.ld"
    else
        echo "No linker file found in $1/autogen"
        return
    fi

    if grep -q c.obj "$linker_file"; then
        return
    fi

    echo "======================================================================"
    echo "Convert linker file *.o -> *.c.obj"
    # Not `sed -i`: GNU takes no argument to -i while BSD sed (macOS) requires
    # one, so there is no spelling that works on both. Redirect instead.
    sed '/crtbegin/! {/crtend/! s/\.o/\.c.obj/g; }' "$linker_file" > "${linker_file}.tmp" \
        && mv "${linker_file}.tmp" "$linker_file"
    # sed -i 's|\*heap_.*\.c.obj)|\*heap_.*\.c.obj \*USART.c.obj \*uart\* \*usart\*)|g' $linker_file
    # sed -i '/\*heap_\*.c.obj(.text\*)/a\
    # *USART.c.obj(.text*)\
    # *uart*(.text*)\
    # *usart*(.text*)' $linker_file
    echo "======================================================================"
}

overwrite_linkerfile()
{
    local tuyaopen_linker_file="${script_dir}/../mcu/defaults/linkerfile_psram_SoC.ld"
    local switch_demo_linker_file="${script_dir}/../mcu/defaults/linkerfile_switch_demo.ld"
    local linker_file=""

    if [[ $2 == *switch_demo* ]]; then
        tuyaopen_linker_file="${switch_demo_linker_file}"
    fi

    if [ -f "$1/autogen/linkerfile_psram_SoC.ld" ]; then
        linker_file="$1/autogen/linkerfile_psram_SoC.ld"
    else
        echo "No linker file found in $1/autogen"
        return
    fi

    echo "======================================================================"
    echo "Uses linker file ${tuyaopen_linker_file}"
    cp ${tuyaopen_linker_file} ${linker_file}
    echo "======================================================================"
}

generate()
{
    local usage="Usage: generate <.slcp file> <output dir>"
    set -x

    # Set 'force' to 1 to force generation. This will overwrite any existing files
    local force=0

    # Parse flags
    optspec=":fh-:"
    while getopts "$optspec" optchar; do
        case "${optchar}" in
            f)
                force=1
                shift
                ;;
            h)
                echo "${usage}" >&2
                exit 2
                ;;
        esac
    done

    # Check args
    if [ $# -lt 2 ] || [ $# -gt 3 ]; then
        echo "Usage: generate <.slcp file> <output dir> <board>"
        return 1
    fi

    # Define generation variables
    local slcp=${1?A .slcp file is expected as the first argument}
    local project_name=""
    project_line=$(grep 'project_name: ' "${slcp}")
    project_name="${project_line//project_name:/}"
    project_name="${project_name// /}"

    local generation_dir=${2?A generation output dir is expected as the second argument}
    local board=${3?A board is expected as the third argument}
    local sdk_path=""
    local build_dir=${OT_CMAKE_BUILD_DIR-"${repo_dir}/build/${board}"}
    local tuyaopen_slc_data=${tuyaopen_slc_data-"${build_dir}/slc/tuyaopen_slc.data"}

    if [ "${board}" = "siwx917_ai_dev_kit" ]; then
        sdk_path="tuyaopen-si91x"
    else
        sdk_path="wiseconnect3_sdk"
    fi

    # Skip generation only when it would produce what is already there.
    #
    # The test used to be "the output directory exists", which meant every
    # change to the project file was silently ignored: slc_generate.py rebuilds
    # this .slcp from the Kconfig on every build, so adding a component or
    # changing a configuration landed in the .slcp and then went nowhere, and
    # the build carried on against a stale export. Adding psram_core and
    # psram_aps6404l_sqh to the platform project cost a round of confusion for
    # exactly this reason -- the #error they fix was still there afterwards.
    #
    # So keep a copy of the .slcp that produced the current export and compare
    # against it. cmp rather than a hash because the .slcp is small and cmp is
    # everywhere, including a Windows shell; a byte comparison also needs no
    # opinion about which hashing tool exists. build_kconfig2slcp.py writes no
    # timestamps, so identical inputs give an identical file and the comparison
    # does not thrash.
    local slcp_stamp="${generation_dir}/.tuyaopen_generated_from.slcp"
    if [ -d "${generation_dir}" ] && [ ${force} -ne 1 ] \
        && [ -f "${slcp_stamp}" ] && cmp -s "${slcp}" "${slcp_stamp}"; then
        set +x
        echo "======================================================================"
        echo "Skipping generation for '${project_name}'."
        echo "unchanged since the last generation: ${slcp}"
        echo "======================================================================"
        set -x
        exit
    fi
    if [ -d "${generation_dir}" ] && [ ${force} -ne 1 ]; then
        set +x
        echo "======================================================================"
        echo "Regenerating '${project_name}': the project file changed."
        echo "======================================================================"
        set -x
    fi

    trust_sdk_and_extensions

    run_slc -v INFO generate \
        -data "${tuyaopen_slc_data?}" \
        --cache-home "${build_dir}/slc/slcc_components.cache" \
        --sdk="${sdk_dir?}" \
        --clear-cache \
        --project-file="${slcp}" \
        --project-name="${project_name}" \
        --output-type=cmake \
        --no-copy \
        --export-destination="${generation_dir}" \
        --with="'${board?};${sdk_path}'"

    overwrite_linkerfile "$generation_dir" "${project_name}"
    patch_linkerfile "$generation_dir"

    # Last, so that a generation that died part-way leaves no stamp and the
    # next build tries again instead of trusting a half-written export.
    cp "${slcp}" "${slcp_stamp}"
}

cleanup()
{
    # Placeholder for any cleanup tasks
    :
}

trap cleanup EXIT

if [ -z "${slc_cmd-}" ] || ! command -v "${slc_cmd}"; then
    # Find slc-cli installation
    slc_init
fi


generate "$@"
