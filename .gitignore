CatalogKconfig
*.build/
*__pycache__*

# Anchored: these are the top-level dirs/files this platform generates or
# fetches. Unanchored they would also swallow any nested dir of the same name
# (mcu/tools/, a future sdks/ under a component, ...).
/build
/tools
/sdks
/TuyaOpen
/.prepare

# Local recovery/debugging tool, deliberately not shipped; what it knew (ROM
# bootloader menu keys, the C-Kermit settings the ROM receiver needs) is in
# GETTING_STARTED.md instead.
/script/siwx917_kermit.sh
/script/siwx917-logs/
